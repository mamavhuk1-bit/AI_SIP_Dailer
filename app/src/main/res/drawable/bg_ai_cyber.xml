<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Obsidian Space Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#070B14"
                android:centerColor="#10182B"
                android:endColor="#0A192F"
                android:type="linear" />
        </shape>
    </item>
    <!-- AI Electric Violet Neural Orb -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.22"
                android:gradientRadius="340dp"
                android:startColor="#669B5DE5"
                android:centerColor="#227B2CBF"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
    <!-- AI Cyber Cyan Ambient Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.72"
                android:gradientRadius="320dp"
                android:startColor="#5500F5D4"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
