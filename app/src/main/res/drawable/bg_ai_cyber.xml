<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Luminous Bright Teal-Indigo-Violet Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#136F8A"
                android:centerColor="#4F46E5"
                android:endColor="#2563EB"
                android:type="linear" />
        </shape>
    </item>
    <!-- Bright Neon Cyan Ambient Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.2"
                android:centerY="0.25"
                android:gradientRadius="360dp"
                android:startColor="#8838BDF8"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
    <!-- Luminous Violet-Pink Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.82"
                android:centerY="0.65"
                android:gradientRadius="340dp"
                android:startColor="#88C084FC"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
